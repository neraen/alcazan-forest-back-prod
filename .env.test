APP_SECRET='t3st-s3cret-alcazan'
SYMFONY_DEPRECATIONS_HELPER=999999
DATABASE_URL=mysql://root:password@mysql:3306/chusei_test
CORS_ALLOW_ORIGIN='^https?://localhost(:[0-9]+)?$'
